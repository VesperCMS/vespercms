---
import { Img, getImg } from '@vesper/astro/components';
import { getCollection, getEntries, getEntry, render } from 'vesper:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const related = post.data.related ? await getEntries(post.data.related) : [];
const { hero } = post.data;
// The social image: the hero's og crop (1.91:1), built in (spec §6.6.3).
const og = hero ? await getImg({ image: hero, ratio: 'og', width: 1200 }) : undefined;
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout title={post.data.title} description={post.data.summary} image={og?.src}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="muted">
      By {author.data.name} ·{' '}
      <time datetime={post.data.publishedAt.toISOString()}>
        {date.format(post.data.publishedAt)}
      </time>
      {post.data.draft && ' · Draft'}
    </p>
    {hero && (
      // Art direction (spec §6.6.5): the square crop on narrow screens, wide from 48rem.
      <Img
        class="hero"
        image={hero}
        art={{ base: 'square', '(min-width: 48rem)': 'wide' }}
        widths={[480, 960, 1440]}
        sizes="(min-width: 46rem) 46rem, 100vw"
      />
    )}
    <Content />
    {post.data.tags.length > 0 && (
      <p>
        <strong>Tags:</strong> {post.data.tags.join(', ')}
      </p>
    )}
    {related.length > 0 && (
      <section aria-labelledby="related-heading">
        <h2 id="related-heading">Related posts</h2>
        <ul>
          {related.map((entry) => (
            <li>
              <a href={`/blog/${entry.id}/`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
