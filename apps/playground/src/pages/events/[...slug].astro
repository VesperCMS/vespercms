---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const location = event.data.location ? await getEntry(event.data.location) : undefined;
const format = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <h1>{event.data.title}</h1>
  <p class="muted">
    <time datetime={event.data.startsAt.toISOString()}>{format.format(event.data.startsAt)}</time>
    {location && ` · ${location.data.name}`}
  </p>
  <Content />
</BaseLayout>
