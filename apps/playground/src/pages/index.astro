---
import { getChildren, getCollection, getEntry, render } from 'vesper:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// The home page's words live in the pages collection (src/content/pages/index.md),
// so editors can change them like any other page.
const home = await getEntry('pages', 'index');
if (!home) throw new Error('src/content/pages/index.md is missing');
const { Content } = await render(home);
const posts = await getCollection('blog');
const authors = await getCollection('authors');
// The top-level pages, in the order of src/content/pages/_order.yaml (spec §6.15.3).
const topLevel = (await getChildren('pages', home)).filter((page) => page.url);
---

<BaseLayout title={home.data.title} description={home.data.summary}>
  <h1>{home.data.title}</h1>
  <Content />

  <h2>Collections</h2>
  <ul>
    <li>
      Pages:{' '}
      {topLevel.map((page, i) => (
        <>
          {i > 0 && ', '}
          <a href={page.url ?? undefined}>{page.title}</a>
        </>
      ))}
      , plus sections nested up to four folders deep.
    </li>
    <li>
      <a href="/blog/">Blog</a>: {posts.length} posts with images, references, tags and dates.
    </li>
    <li>Authors: {authors.length} people, stored as one JSON file.</li>
  </ul>
</BaseLayout>
