---
import { Search, SearchHead } from '@vesper/astro/components';
import { getEntry } from 'vesper:content';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** A social image's URL (`getImg()` with the built-in og ratio). */
  image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('src/content/settings/site.yaml is missing');
const { siteName, tagline } = settings.data;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/academics/', label: 'Academics' },
  { href: '/campus-life/', label: 'Campus life' },
  { href: '/blog/', label: 'Blog' },
  { href: '/docs/', label: 'Docs' },
  { href: '/events/', label: 'Events' },
  { href: '/locations/', label: 'Locations' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {
      // Absolute when the site sets `site`, as social networks need; the playground doesn't.
      image && (
        <meta property="og:image" content={Astro.site ? new URL(image, Astro.site) : image} />
      )
    }
    <SearchHead />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="site-name" href="/">
        {siteName}
      </a>
      <Search />
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? current === '/'
                      ? 'page'
                      : undefined
                    : current.startsWith(item.href)
                      ? 'page'
                      : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{tagline} All content is fictional.</p>
    </footer>
  </body>
</html>
