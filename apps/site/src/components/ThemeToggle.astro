---
import Icon from './Icon.astro';

// Light or dark, over the system's choice. Every colour on the site is a
// `light-dark()` pair, so setting `color-scheme` on the root switches them
// all; Base.astro's inline script applies a stored choice before first paint.
// Choosing the system's own theme forgets the choice, so a visitor who
// switches back follows the system again.
---

<button type="button" class="theme-toggle" aria-pressed="false" data-theme-toggle>
  <span class="visually-hidden">Dark theme</span>
  <Icon name="sun" size={18} class="theme-toggle-sun" />
  <Icon name="moon" size={18} class="theme-toggle-moon" />
</button>

<script>
  const KEY = 'vesper-theme';
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const isDark = () => (root.dataset.theme ?? (system.matches ? 'dark' : 'light')) === 'dark';

  function sync() {
    for (const button of buttons) button.setAttribute('aria-pressed', String(isDark()));
  }

  function choose(theme: 'light' | 'dark') {
    const followSystem = theme === (system.matches ? 'dark' : 'light');
    if (followSystem) delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (followSystem) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, theme);
    } catch {
      // Storage can be off; the choice then lasts for this page.
    }
    sync();
  }

  for (const button of buttons) {
    button.addEventListener('click', (event) => {
      const next = isDark() ? 'light' : 'dark';
      if (reduced.matches || !('startViewTransition' in document)) {
        choose(next);
        return;
      }
      // The new theme spreads from the button in a circle (site.css).
      const box = button.getBoundingClientRect();
      const x = event.clientX || box.left + box.width / 2;
      const y = event.clientY || box.top + box.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.style.setProperty('--theme-x', `${String(x)}px`);
      root.style.setProperty('--theme-y', `${String(y)}px`);
      root.style.setProperty('--theme-r', `${String(radius)}px`);
      document.startViewTransition(() => {
        choose(next);
      });
    });
  }

  system.addEventListener('change', sync);
  sync();
</script>
