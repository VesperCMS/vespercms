---
import type { CollectionEntry } from 'vesper:content';
import { render } from 'vesper:content';
import { inlineMarkdown } from '../lib/inline-markdown.ts';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import Shot from './Shot.astro';

// A marketing page: its hero (or title), its body, its sections and its
// closing. Every part is a field in the studio, and the layout follows the
// content: a section with a picture is a row beside it, points with pictures
// are cards with the picture on top, and the rest are cards with an icon.
interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { hero, sections, closing, title, summary } = page.data;
const { Content } = await render(page);

// Rows alternate sides, counted among the sections that are rows.
let rows = 0;
const laidOut = sections.map((section, i) => ({
  section,
  id: `section-${String(i)}`,
  flip: section.image ? rows++ % 2 === 1 : false,
  cards: section.points.filter((point) => point.image),
  plain: section.points.filter((point) => !point.image),
}));
---

{hero ? (
  <section class="hero" aria-labelledby="page-title" data-hero>
    <canvas class="hero-canvas" aria-hidden="true" data-hero-canvas />
    <span class="hero-probe" hidden data-hero-probe />
    <div class="hero-inner">
      <div class="hero-text">
        <h1 id="page-title">{hero.heading}</h1>
        <p class="lead">{hero.lead}</p>
        {hero.actions.length > 0 && (
          <p class="actions">
            {hero.actions.map((action, i) => (
              <a class:list={['button', i === 0 && 'button-primary']} href={action.href}>
                {action.label}
                {i === 0 && <Icon name="arrow-right" size={18} class="button-arrow" />}
              </a>
            ))}
          </p>
        )}
      </div>
      <div class="hero-mark" data-hero-slot>
        <Mark size={320} class="hero-fallback" />
      </div>
    </div>
  </section>
) : (
  <div class="page">
    <div class="page-title">
      <h1 id="page-title">{title}</h1>
      <p class="lead">{summary}</p>
    </div>
  </div>
)}
<div class="page">
  <div class="prose">
    <Content />
  </div>
  {laidOut.map(({ section, id, flip, cards, plain }) =>
    section.image ? (
      <section class:list={['section', 'feature', flip && 'feature-flip']} aria-labelledby={id}>
        <div class="feature-text">
          <h2 id={id}>{section.heading}</h2>
          {section.intro && <p class="section-intro" set:html={inlineMarkdown(section.intro)} />}
          {section.points.length > 0 && (
            <ul class="feature-points">
              {section.points.map((point) => (
                <li>
                  {point.icon && (
                    <span class="point-icon">
                      <Icon name={point.icon} />
                    </span>
                  )}
                  <div>
                    <h3>{point.title}</h3>
                    <p set:html={inlineMarkdown(point.body)} />
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
        <Shot
          image={section.image}
          dark={section.imageDark}
          sizes="(min-width: 64rem) 40rem, calc(100vw - 3rem)"
          class="feature-shot"
        />
      </section>
    ) : (
      <section class="section" aria-labelledby={id}>
        <div class="section-head">
          <h2 id={id}>{section.heading}</h2>
          {section.intro && <p class="section-intro" set:html={inlineMarkdown(section.intro)} />}
        </div>
        {cards.length > 0 && (
          <ul class="showcase">
            {cards.map((point) => (
              <li class="showcase-card">
                {point.image && (
                  <Shot
                    image={point.image}
                    dark={point.imageDark}
                    sizes="(min-width: 48rem) 34rem, calc(100vw - 3rem)"
                  />
                )}
                <div class="showcase-text">
                  <h3>
                    {point.icon && <Icon name={point.icon} class="inline-icon" />}
                    {point.title}
                  </h3>
                  <p set:html={inlineMarkdown(point.body)} />
                </div>
              </li>
            ))}
          </ul>
        )}
        {plain.length > 0 && (
          <ul class="points">
            {plain.map((point) => (
              <li class="point">
                {point.icon && (
                  <span class="point-icon">
                    <Icon name={point.icon} />
                  </span>
                )}
                <h3>{point.title}</h3>
                <p set:html={inlineMarkdown(point.body)} />
              </li>
            ))}
          </ul>
        )}
      </section>
    ),
  )}
  {closing && (
    <section class="closing" aria-labelledby="closing-title">
      <h2 id="closing-title">{closing.heading}</h2>
      {closing.lead && <p class="lead" set:html={inlineMarkdown(closing.lead)} />}
      {closing.command && (
        <div class="command">
          <code>{closing.command}</code>
          <button type="button" class="command-copy" data-copy={closing.command} hidden>
            <Icon name="copy" size={16} />
            <span data-copy-label>Copy</span>
          </button>
          <span class="visually-hidden" role="status" data-copy-status />
        </div>
      )}
      {closing.actions.length > 0 && (
        <p class="actions">
          {closing.actions.map((action, i) => (
            <a class:list={['button', i === 0 && 'button-primary']} href={action.href}>
              {action.label}
              {i === 0 && <Icon name="arrow-right" size={18} class="button-arrow" />}
            </a>
          ))}
        </p>
      )}
    </section>
  )}
</div>

<script>
  import { startHeroArt } from '../lib/hero-art.ts';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) startHeroArt(hero);

  // The closing's command: Copy is there only where the clipboard is.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    if (!('clipboard' in navigator)) continue;
    button.hidden = false;
    const label = button.querySelector('[data-copy-label]');
    const status = button.parentElement?.querySelector('[data-copy-status]');
    let timer = 0;
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(button.dataset.copy ?? '').then(
        () => {
          if (label) label.textContent = 'Copied';
          if (status) status.textContent = 'Copied to the clipboard';
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            if (label) label.textContent = 'Copy';
            if (status) status.textContent = '';
          }, 2000);
        },
        () => {
          if (status) status.textContent = 'Couldn’t copy. Select the command instead.';
        },
      );
    });
  }
</script>
