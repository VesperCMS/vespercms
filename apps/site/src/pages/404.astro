---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="page">
    <div class="page-title">
      <h1>Page not found</h1>
      <p class="lead">There's nothing at this address. It may have moved.</p>
      <p class="actions">
        <a class="button button-primary" href="/docs/">
          Go to the docs
        </a>
        <a class="button" href="/search/">
          Search the site
        </a>
      </p>
    </div>
  </div>
</Base>
