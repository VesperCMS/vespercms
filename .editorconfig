root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Content fixtures are byte-exact test data. Editors must leave them alone.
[{packages/core/test/corpus/**,packages/core/test/fixtures/**,apps/playground/src/content/**,apps/playground/src/data/**}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
