---
/*
 * The studio page (spec §6.1), injected at /admin and always prerendered: a
 * static shell that works with `output: 'static'` and no adapter. The
 * studio's screens use hash routes, so deep links work on any host (D16).
 */
import { siteName } from 'virtual:vesper/page';

// The screen, then the site, as every screen sets it once the studio runs
// (DECISIONS.md, "The studio's tab title is always the screen, then the site").
// "{siteName} · Vesper" read "Vesper · Vesper" on Vesper's own site.
const title = `Studio · ${siteName}`;

// Vesper's mark, small cut, as /admin's favicon (DECISIONS.md, "Vesper's mark
// is Launch"). Inline, so it costs no request. A favicon can't read CSS
// variables, so it carries Pine's content and accent values for each theme.
const favicon = `data:image/svg+xml,${encodeURIComponent(
  [
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">',
    '<style>path{stroke:#282019}circle{fill:#226b63}',
    '@media (prefers-color-scheme:dark){path{stroke:#f3ede7}circle{fill:#63ccc0}}</style>',
    '<path d="M11 14 L29 50 L42 25" fill="none" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>',
    '<circle cx="52" cy="11" r="7"/>',
    '</svg>',
  ].join(''),
)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {/*
     * The editor's Light or Dark choice, before the page paints, so a dark
     * choice doesn't flash light while the studio loads. The studio applies it
     * again when it starts (DECISIONS.md, "Appearance is in the user menu").
     */}
    <script is:inline>
      try {
        var theme = localStorage.getItem('vesper:appearance');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div id="vesper-studio">
      <p>Loading the studio…</p>
      <noscript>
        <p>The studio needs JavaScript.</p>
      </noscript>
    </div>
    <script>
      import 'virtual:vesper/studio';
    </script>
  </body>
</html>
