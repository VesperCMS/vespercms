---
/*
 * <Form> (spec §6.13): a form from src/forms.config.ts, posting to the
 * cloud.
 *
 *   <Form name="contact" />
 *
 * The markup is core's `formHtml`, which the cloud also draws when a post
 * without JavaScript needs another look. Without JavaScript the form posts
 * and the cloud sends the browser back to this page's sent message. With it,
 * ./form/ui.ts checks answers as they're typed, posts without leaving the
 * page, and moves focus to the error summary or the sent message.
 *
 * It inherits the site's font and colours; the README lists the custom
 * properties that theme it. Without a cloud project it says the form isn't
 * connected yet, and the build warns.
 */
import { formHtml, type FormStrings } from '@vespercms/core/forms';
import { forms } from 'virtual:vesper/forms';

interface Props {
  /** The form's key in src/forms.config.ts. */
  name: string;
  /** For a second copy of one form on a page. */
  id?: string;
  /** Vesper's own words on the form, such as the button's, in the page's language. */
  strings?: Partial<FormStrings>;
}

const { name, id, strings } = Astro.props;
const form = forms.definitions[name];
if (!form) {
  throw new Error(`<Form name="${name}">: src/forms.config.ts has no form named "${name}".`);
}
const action = forms.endpoint === null ? null : `${forms.endpoint}/${encodeURIComponent(name)}`;
const html = formHtml(form, {
  action,
  page: Astro.url.pathname,
  manifest: forms.manifest,
  sentMessage: true,
  config: JSON.stringify({ form, endpoint: forms.endpoint, strings: strings ?? {} }),
  ...(id ? { id } : {}),
  ...(strings ? { strings } : {}),
});
---

<Fragment set:html={html} />

<script>
  import { mountForms } from './form/ui.ts';
  mountForms();
</script>

<style is:global>
  /*
   * Inherits the site's font and colours. Theme it with these properties:
   * --vesper-form-error (error text and the summary's border),
   * --vesper-form-border (fields' borders) and --vesper-form-radius.
   */
  .vesper-form {
    font: inherit;
  }
  .vesper-form-form > * + * {
    margin-block-start: 1.25rem;
  }
  .vesper-form-field,
  .vesper-form-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .vesper-form label,
  .vesper-form legend {
    display: block;
    font-weight: 600;
  }
  .vesper-form-group > legend {
    margin-block-end: 0.75rem;
  }
  .vesper-form-group > * + * {
    margin-block-start: 1rem;
  }
  .vesper-form-help,
  .vesper-form-error {
    margin: 0.25rem 0;
  }
  .vesper-form-error {
    font-weight: 600;
    color: var(--vesper-form-error, light-dark(#b3261e, #ffb4ab));
  }
  .vesper-form input:not([type='checkbox'], [type='radio']),
  .vesper-form select,
  .vesper-form textarea {
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 40rem;
    margin-block-start: 0.25rem;
    padding: 0.5rem 0.625rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--vesper-form-border, currentColor);
    border-radius: var(--vesper-form-radius, 0.375rem);
  }
  .vesper-form [aria-invalid='true'] {
    border-color: var(--vesper-form-error, light-dark(#b3261e, #ffb4ab));
    border-width: 2px;
  }
  .vesper-form-choice,
  .vesper-form-check {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-block-start: 0.375rem;
  }
  .vesper-form-choice label,
  .vesper-form-check label {
    font-weight: 400;
  }
  .vesper-form-check {
    flex-wrap: wrap;
  }
  .vesper-form-check > .vesper-form-help,
  .vesper-form-check > .vesper-form-error {
    flex-basis: 100%;
  }
  .vesper-form input[type='checkbox'],
  .vesper-form input[type='radio'] {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin: 0;
    flex: none;
    translate: 0 0.15em;
  }
  .vesper-form-summary {
    padding: 1rem;
    border: 2px solid var(--vesper-form-error, light-dark(#b3261e, #ffb4ab));
    border-radius: var(--vesper-form-radius, 0.375rem);
  }
  .vesper-form-summary h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25em;
  }
  .vesper-form-summary ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .vesper-form-summary a {
    color: inherit;
    font-weight: 600;
  }
  .vesper-form-summary[hidden],
  .vesper-form-status:empty {
    display: none;
  }
  .vesper-form-submit {
    min-block-size: 2.75rem;
    padding: 0.5rem 1.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .vesper-form-submit[aria-disabled='true'] {
    cursor: progress;
  }
  /* The honeypot: off the screen, and aria-hidden in the markup. */
  .vesper-form-hp {
    position: absolute;
    inset-inline-start: -10000px;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
  }
  /* Sent: without JavaScript the page arrives at #vesper-form-…-sent; with it, the script sets data-sent. */
  .vesper-form-sent {
    display: none;
  }
  .vesper-form-sent:target,
  .vesper-form[data-sent] .vesper-form-sent {
    display: block;
  }
  .vesper-form:has(.vesper-form-sent:target) .vesper-form-form,
  .vesper-form[data-sent] .vesper-form-form {
    display: none;
  }
  .vesper-form-sent:focus {
    outline: none;
  }
  .vesper-form-summary:focus-visible,
  .vesper-form :focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }
</style>
