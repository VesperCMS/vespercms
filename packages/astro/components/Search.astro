---
/*
 * <Search> (spec §6.19): site search on the index the build writes to
 * `_vesper/search/`. Put it in the header of a layout:
 *
 *   <Search />                    a "Search" button that opens a dialog (Ctrl/⌘+K)
 *   <Search variant="inline" />   the field and results in the page, as on /search
 *   <Search shortcut={false} />   no Ctrl/⌘+K
 *
 * Without JavaScript the button is a link to /search, whose form explains
 * that search needs JavaScript (or, with `noJsFallback: 'duckduckgo'`,
 * searches the site there). It inherits the site's font and colours; the
 * README lists the custom properties that theme it.
 */
import { search } from 'virtual:vesper/search';
import { stringsFor } from './search/strings.ts';

interface Props {
  variant?: 'dialog' | 'inline';
  /** Ctrl/⌘+K opens the dialog. On by default. */
  shortcut?: boolean;
  /** The page's language, for the words rendered here; the script reads `<html lang>`. */
  lang?: string;
  /** For a second `<Search>` on one page. */
  id?: string;
  class?: string;
}

const {
  variant = 'dialog',
  shortcut = true,
  lang = Astro.currentLocale ?? 'en',
  class: className,
} = Astro.props;
const id = Astro.props.id ?? (variant === 'inline' ? 'vesper-search-page' : 'vesper-search');
const t = stringsFor(search.strings, lang);
const config = JSON.stringify({
  bundle: search.bundle,
  page: search.page,
  strings: search.strings,
  sort: search.sort,
  shortcut,
});
const duckDuckGo = search.noJsFallback === 'duckduckgo' && search.host !== null;
const noJsLink = search.noJsLink ?? search.home;
---

<div
  class:list={['vesper-search', `vesper-search-${variant}`, className]}
  data-vesper-search={variant}
  data-vesper-search-config={config}
  data-pagefind-ignore="all"
>
  {variant === 'dialog' ? (
    <>
      <a class="vesper-search-trigger" href={search.page} data-vesper-search-trigger>
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        {t.button}
      </a>
      <dialog class="vesper-search-modal" aria-labelledby={`${id}-label`}>
        <div class="vesper-search-panel">
          <div class="vesper-search-top">
            <form role="search" action={search.page} method="get" class="vesper-search-form">
              <label id={`${id}-label`} for={`${id}-field`}>
                {t.label}
              </label>
              <input
                id={`${id}-field`}
                type="search"
                name="q"
                autocomplete="off"
                spellcheck="false"
              />
            </form>
            <button type="button" class="vesper-search-close" data-vesper-search-close>
              {t.close}
            </button>
          </div>
          <p class="vesper-search-status" role="status" data-vesper-search-status />
          <div class="vesper-search-body">
            <div class="vesper-search-filters" data-vesper-search-filters />
            <div class="vesper-search-results" data-vesper-search-results />
          </div>
        </div>
      </dialog>
    </>
  ) : (
    <>
      <form
        role="search"
        action={duckDuckGo ? 'https://duckduckgo.com/' : search.page}
        method="get"
        class="vesper-search-form"
      >
        <label for={`${id}-field`}>{t.label}</label>
        <div class="vesper-search-row">
          <input id={`${id}-field`} type="search" name="q" autocomplete="off" spellcheck="false" />
          <button type="submit">{t.button}</button>
        </div>
        {duckDuckGo && (
          <input type="hidden" name="sites" value={search.host} data-vesper-search-nojs />
        )}
      </form>
      <noscript>
        {duckDuckGo ? (
          <p>{t.noJsDuckDuckGo}</p>
        ) : (
          <p>
            {t.noJs} <a href={noJsLink}>{search.noJsLink ? t.noJsLink : t.noJsHome}</a>
            {search.sitemap && (
              <>
                {' · '}
                <a href={search.sitemap}>{t.noJsSitemap}</a>
              </>
            )}
          </p>
        )}
      </noscript>
      <p class="vesper-search-status" role="status" data-vesper-search-status />
      <div class="vesper-search-body">
        <div class="vesper-search-filters" data-vesper-search-filters />
        <div class="vesper-search-results" data-vesper-search-results />
      </div>
    </>
  )}
</div>

<script>
  import { mountSearch } from './search/ui.ts';
  mountSearch();
</script>

<style is:global>
  /*
   * Inherits the site's font and colours. Theme it with these properties:
   * --vesper-search-accent (focus and marks), --vesper-search-surface (the
   * dialog's background), --vesper-search-border and --vesper-search-radius.
   */
  .vesper-search {
    font: inherit;
  }
  .vesper-search-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .vesper-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.25rem 0.75rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--vesper-search-border, currentColor);
    border-radius: var(--vesper-search-radius, 0.5rem);
    text-decoration: none;
    cursor: pointer;
  }
  .vesper-search-modal {
    width: min(44rem, 100vw - 2rem);
    max-height: min(40rem, 100dvh - 2rem);
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    color: inherit;
    background: var(--vesper-search-surface, Canvas);
    border: 1px solid var(--vesper-search-border, currentColor);
    border-radius: var(--vesper-search-radius, 0.5rem);
  }
  .vesper-search-modal::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .vesper-search-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
  }
  .vesper-search-top {
    display: flex;
    align-items: end;
    gap: 0.75rem;
  }
  .vesper-search-form {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    margin: 0;
  }
  .vesper-search-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .vesper-search-row input {
    flex: 1 1 12rem;
  }
  .vesper-search input[type='search'],
  .vesper-search select {
    min-width: 0;
    max-width: 100%;
    min-height: 2.5rem;
    padding: 0.25rem 0.5rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--vesper-search-border, currentColor);
    border-radius: var(--vesper-search-radius, 0.5rem);
  }
  .vesper-search-close,
  .vesper-search-more,
  .vesper-search-row button {
    min-height: 2.5rem;
    padding: 0.25rem 0.75rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--vesper-search-border, currentColor);
    border-radius: var(--vesper-search-radius, 0.5rem);
    cursor: pointer;
  }
  .vesper-search :focus-visible {
    outline: 3px solid var(--vesper-search-accent, Highlight);
    outline-offset: 2px;
  }
  .vesper-search-status {
    margin: 0;
  }
  .vesper-search-status:empty {
    display: none;
  }
  .vesper-search-body {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .vesper-search-body:has(.vesper-search-filter, .vesper-search-sort label) {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .vesper-search-filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .vesper-search-filters:empty {
    display: none;
  }
  .vesper-search-filter {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .vesper-search-filter legend {
    padding: 0;
    font-weight: 600;
  }
  .vesper-search-option {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .vesper-search-sort {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .vesper-search-sort:empty {
    display: none;
  }
  .vesper-search-sort label {
    font-weight: 600;
  }
  .vesper-search-results {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .vesper-search-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vesper-search-result {
    display: flex;
    gap: 0.75rem;
    align-items: start;
  }
  .vesper-search-thumbnail {
    flex: none;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: calc(var(--vesper-search-radius, 0.5rem) / 2);
  }
  .vesper-search-link {
    font-weight: 600;
  }
  .vesper-search-date {
    display: block;
    font-size: 0.875em;
  }
  .vesper-search-excerpt {
    margin: 0.25rem 0 0;
  }
  .vesper-search mark {
    color: inherit;
    background: var(--vesper-search-mark, Mark);
    background: color-mix(in srgb, var(--vesper-search-accent, Mark) 25%, transparent);
  }
  .vesper-search-more {
    align-self: start;
    margin-top: 1rem;
  }
  html.vesper-search-open {
    overflow: hidden;
  }
  @media (forced-colors: active) {
    /* Matches stay visible in contrast themes, where a transparent mark would vanish. */
    .vesper-search mark {
      color: MarkText;
      background: Mark;
      forced-color-adjust: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vesper-search * {
      transition: none;
      animation: none;
    }
  }
</style>
