{
  "manifestVersion": 1,
  "site": {
    "srcDir": "src",
    "contentConfig": "src/content.config.ts",
    "timeZone": "America/New_York",
    "images": {
      "ratios": {
        "wide": 1.7777777777777777,
        "square": 1,
        "portrait": 0.8,
        "og": 1.91
      }
    }
  },
  "collections": [
    {
      "name": "blog",
      "label": "Blog posts",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/blog",
        "pattern": "**/[^_]*.md",
        "generateId": "default",
        "formats": [
          "md"
        ]
      },
      "entryKind": "content",
      "fields": [
        {
          "path": [
            "title"
          ],
          "kind": "string",
          "required": true,
          "label": "Title",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "summary"
          ],
          "kind": "string",
          "required": true,
          "label": "Summary",
          "description": "One or two sentences for cards and search.",
          "widget": "textarea",
          "inferredWidget": "text"
        },
        {
          "path": [
            "hero"
          ],
          "kind": "object",
          "required": false,
          "label": "Hero",
          "widget": "image",
          "widgetOptions": {
            "ratios": [
              "wide",
              "square"
            ]
          },
          "children": [
            {
              "path": [
                "hero",
                "src"
              ],
              "kind": "image",
              "required": true,
              "label": "Src",
              "inferredWidget": "image",
              "widget": "image"
            },
            {
              "path": [
                "hero",
                "alt"
              ],
              "kind": "string",
              "required": true,
              "label": "Alt",
              "inferredWidget": "text",
              "widget": "text"
            },
            {
              "path": [
                "hero",
                "decorative"
              ],
              "kind": "boolean",
              "required": false,
              "label": "Decorative",
              "inferredWidget": "switch",
              "widget": "switch"
            },
            {
              "path": [
                "hero",
                "focus"
              ],
              "kind": "object",
              "required": false,
              "label": "Focal point",
              "children": [
                {
                  "path": [
                    "hero",
                    "focus",
                    "x"
                  ],
                  "kind": "number",
                  "required": true,
                  "label": "X",
                  "constraints": {
                    "min": 0,
                    "max": 1
                  },
                  "inferredWidget": "number",
                  "widget": "number"
                },
                {
                  "path": [
                    "hero",
                    "focus",
                    "y"
                  ],
                  "kind": "number",
                  "required": true,
                  "label": "Y",
                  "constraints": {
                    "min": 0,
                    "max": 1
                  },
                  "inferredWidget": "number",
                  "widget": "number"
                }
              ],
              "extraKeys": "strip",
              "inferredWidget": "group",
              "widget": "group"
            },
            {
              "path": [
                "hero",
                "crops"
              ],
              "kind": "unknown",
              "required": false,
              "label": "Crops",
              "unknownReason": "record",
              "inferredWidget": "raw",
              "widget": "raw"
            }
          ],
          "extraKeys": "strip",
          "inferredWidget": "group"
        },
        {
          "path": [
            "author"
          ],
          "kind": "reference",
          "required": true,
          "label": "Author",
          "reference": {
            "collection": "authors"
          },
          "inferredWidget": "reference",
          "widget": "reference"
        },
        {
          "path": [
            "related"
          ],
          "kind": "array",
          "required": false,
          "label": "Related",
          "children": [
            {
              "path": [
                "related",
                "[]"
              ],
              "kind": "reference",
              "required": true,
              "label": "Item",
              "reference": {
                "collection": "blog"
              },
              "inferredWidget": "reference",
              "widget": "reference"
            }
          ],
          "inferredWidget": "references",
          "widget": "references"
        },
        {
          "path": [
            "tags"
          ],
          "kind": "array",
          "required": false,
          "label": "Tags",
          "default": [],
          "children": [
            {
              "path": [
                "tags",
                "[]"
              ],
              "kind": "string",
              "required": true,
              "label": "Item",
              "inferredWidget": "text",
              "widget": "text"
            }
          ],
          "inferredWidget": "tags",
          "widget": "tags"
        },
        {
          "path": [
            "category"
          ],
          "kind": "enum",
          "required": true,
          "label": "Category",
          "widgetOptions": {
            "labels": {
              "news": "News",
              "guides": "Guides",
              "stories": "Stories"
            }
          },
          "constraints": {
            "options": [
              {
                "value": "news",
                "label": "News"
              },
              {
                "value": "guides",
                "label": "Guides"
              },
              {
                "value": "stories",
                "label": "Stories"
              }
            ]
          },
          "inferredWidget": "radio",
          "widget": "radio"
        },
        {
          "path": [
            "publishedAt"
          ],
          "kind": "date",
          "required": true,
          "label": "Published at",
          "coerce": true,
          "inferredWidget": "date",
          "widget": "date"
        },
        {
          "path": [
            "updatedAt"
          ],
          "kind": "date",
          "required": false,
          "label": "Updated at",
          "inferredWidget": "date",
          "widget": "date"
        },
        {
          "path": [
            "draft"
          ],
          "kind": "boolean",
          "required": false,
          "label": "Draft",
          "default": false,
          "inferredWidget": "switch",
          "widget": "switch"
        },
        {
          "path": [
            "series"
          ],
          "kind": "unknown",
          "required": false,
          "label": "Series",
          "unknownReason": "union",
          "inferredWidget": "raw",
          "widget": "raw"
        }
      ],
      "extraKeys": "strip",
      "presentation": {
        "url": "/blog/:id",
        "listFields": [
          "title",
          "publishedAt"
        ],
        "newEntryPath": ":slug"
      }
    },
    {
      "name": "authors",
      "label": "People",
      "editable": true,
      "source": {
        "loader": "file",
        "path": "src/data/authors.json",
        "format": "json",
        "customParser": false
      },
      "entryKind": "data",
      "fields": [
        {
          "path": [
            "name"
          ],
          "kind": "string",
          "required": true,
          "label": "Name",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "role"
          ],
          "kind": "string",
          "required": false,
          "label": "Role",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "email"
          ],
          "kind": "string",
          "required": true,
          "label": "Email",
          "widget": "email",
          "autocomplete": "email",
          "format": "email",
          "inferredWidget": "email"
        },
        {
          "path": [
            "url"
          ],
          "kind": "string",
          "required": false,
          "label": "URL",
          "widget": "url",
          "format": "url",
          "inferredWidget": "url"
        },
        {
          "path": [
            "handle"
          ],
          "kind": "string",
          "required": false,
          "label": "Handle",
          "widget": "slug",
          "widgetOptions": {
            "from": "name"
          },
          "constraints": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "inferredWidget": "text"
        }
      ],
      "extraKeys": "strip",
      "presentation": {}
    },
    {
      "name": "pages",
      "label": "Pages",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/pages",
        "pattern": "**/[^_]*.{md,mdx}",
        "generateId": "default",
        "formats": [
          "md",
          "mdx"
        ]
      },
      "entryKind": "content",
      "fields": [
        {
          "path": [
            "title"
          ],
          "kind": "string",
          "required": true,
          "label": "Title",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "summary"
          ],
          "kind": "string",
          "required": false,
          "label": "Summary",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "nav"
          ],
          "kind": "object",
          "required": false,
          "label": "Navigation",
          "children": [
            {
              "path": [
                "nav",
                "label"
              ],
              "kind": "string",
              "required": false,
              "label": "Label",
              "description": "Shorter title for menus.",
              "inferredWidget": "text",
              "widget": "text"
            },
            {
              "path": [
                "nav",
                "hidden"
              ],
              "kind": "boolean",
              "required": false,
              "label": "Hidden",
              "default": false,
              "inferredWidget": "switch",
              "widget": "switch"
            }
          ],
          "extraKeys": "strip",
          "inferredWidget": "group",
          "widget": "group"
        },
        {
          "path": [
            "sections"
          ],
          "kind": "array",
          "required": false,
          "label": "Sections",
          "default": [],
          "children": [
            {
              "path": [
                "sections",
                "[]"
              ],
              "kind": "object",
              "required": true,
              "label": "Item",
              "children": [
                {
                  "path": [
                    "sections",
                    "[]",
                    "heading"
                  ],
                  "kind": "string",
                  "required": true,
                  "label": "Heading",
                  "inferredWidget": "text",
                  "widget": "text"
                },
                {
                  "path": [
                    "sections",
                    "[]",
                    "body"
                  ],
                  "kind": "string",
                  "required": true,
                  "label": "Body",
                  "widget": "markdown",
                  "widgetOptions": {
                    "inline": true
                  },
                  "inferredWidget": "text"
                }
              ],
              "extraKeys": "strip",
              "inferredWidget": "group",
              "widget": "group"
            }
          ],
          "inferredWidget": "repeater",
          "widget": "repeater"
        },
        {
          "path": [
            "brochure"
          ],
          "kind": "string",
          "required": false,
          "label": "Brochure",
          "widget": "file",
          "widgetOptions": {
            "accept": "application/pdf"
          },
          "inferredWidget": "text"
        }
      ],
      "extraKeys": "strip",
      "presentation": {
        "tree": true,
        "url": "/:path"
      }
    },
    {
      "name": "docs",
      "label": "Docs",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/docs",
        "pattern": "**/[^_]*.mdoc",
        "generateId": "default",
        "formats": [
          "mdoc"
        ]
      },
      "entryKind": "content",
      "fields": [
        {
          "path": [
            "title"
          ],
          "kind": "string",
          "required": true,
          "label": "Title",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "summary"
          ],
          "kind": "string",
          "required": true,
          "label": "Summary",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "order"
          ],
          "kind": "number",
          "required": false,
          "label": "Order",
          "constraints": {
            "integer": true
          },
          "inferredWidget": "number",
          "widget": "number"
        },
        {
          "path": [
            "updated"
          ],
          "kind": "date",
          "required": false,
          "label": "Updated",
          "widget": "datetime",
          "coerce": true,
          "inferredWidget": "date"
        }
      ],
      "extraKeys": "strip",
      "presentation": {
        "url": "/docs/:id"
      }
    },
    {
      "name": "settings",
      "label": "Site settings",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/settings",
        "pattern": "site.yaml",
        "generateId": "default",
        "formats": [
          "yaml"
        ]
      },
      "entryKind": "data",
      "fields": [
        {
          "path": [
            "siteName"
          ],
          "kind": "string",
          "required": true,
          "label": "Site name",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "tagline"
          ],
          "kind": "string",
          "required": true,
          "label": "Tagline",
          "widget": "textarea",
          "inferredWidget": "text"
        },
        {
          "path": [
            "brandColor"
          ],
          "kind": "string",
          "required": true,
          "label": "Brand color",
          "widget": "color",
          "widgetOptions": {
            "palette": {
              "Indigo": "#28335f",
              "Pine": "#2f5d50",
              "Brick": "#8a3b3b"
            }
          },
          "constraints": {
            "pattern": "^#[0-9a-f]{6}$",
            "patternFlags": "i"
          },
          "inferredWidget": "text"
        },
        {
          "path": [
            "website"
          ],
          "kind": "string",
          "required": true,
          "label": "Website",
          "widget": "url",
          "format": "url",
          "inferredWidget": "url"
        },
        {
          "path": [
            "headquarters"
          ],
          "kind": "object",
          "required": false,
          "label": "Headquarters",
          "widget": "geo",
          "widgetOptions": {
            "zoom": 14
          },
          "children": [
            {
              "path": [
                "headquarters",
                "lat"
              ],
              "kind": "number",
              "required": true,
              "label": "Lat",
              "constraints": {
                "min": -90,
                "max": 90
              },
              "inferredWidget": "number",
              "widget": "number"
            },
            {
              "path": [
                "headquarters",
                "lng"
              ],
              "kind": "number",
              "required": true,
              "label": "Lng",
              "constraints": {
                "min": -180,
                "max": 180
              },
              "inferredWidget": "number",
              "widget": "number"
            }
          ],
          "extraKeys": "strip",
          "inferredWidget": "group"
        },
        {
          "path": [
            "timeZone"
          ],
          "kind": "string",
          "required": true,
          "label": "Time zone",
          "description": "IANA time zone name, for example America/New_York (spec §6.17).",
          "inferredWidget": "text",
          "widget": "text"
        },
        {
          "path": [
            "social"
          ],
          "kind": "array",
          "required": false,
          "label": "Social",
          "default": [],
          "children": [
            {
              "path": [
                "social",
                "[]"
              ],
              "kind": "object",
              "required": true,
              "label": "Item",
              "children": [
                {
                  "path": [
                    "social",
                    "[]",
                    "network"
                  ],
                  "kind": "enum",
                  "required": true,
                  "label": "Network",
                  "constraints": {
                    "options": [
                      {
                        "value": "mastodon",
                        "label": "mastodon"
                      },
                      {
                        "value": "bluesky",
                        "label": "bluesky"
                      },
                      {
                        "value": "instagram",
                        "label": "instagram"
                      },
                      {
                        "value": "youtube",
                        "label": "youtube"
                      },
                      {
                        "value": "linkedin",
                        "label": "linkedin"
                      }
                    ]
                  },
                  "inferredWidget": "select",
                  "widget": "select"
                },
                {
                  "path": [
                    "social",
                    "[]",
                    "url"
                  ],
                  "kind": "string",
                  "required": true,
                  "label": "URL",
                  "widget": "url",
                  "format": "url",
                  "inferredWidget": "url"
                }
              ],
              "extraKeys": "strip",
              "inferredWidget": "group",
              "widget": "group"
            }
          ],
          "inferredWidget": "repeater",
          "widget": "repeater"
        }
      ],
      "extraKeys": "strip",
      "presentation": {
        "singleton": true
      }
    },
    {
      "name": "locations",
      "label": "Locations",
