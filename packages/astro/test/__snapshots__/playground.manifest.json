              "required": true,
              "label": "Lat",
              "constraints": {
                "min": -90,
                "max": 90
              },
              "inferredWidget": "number",
              "widget": "number"
            },
            {
              "path": [
                "geo",
                "lng"
              ],
              "kind": "number",
              "required": true,
