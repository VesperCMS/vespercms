    {
      "name": "fixtures",
      "label": "Accessibility fixtures",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/fixtures",
        "pattern": "**/[^_]*.mdoc",
        "generateId": "default",
        "formats": [
          "mdoc"
        ]
      },
