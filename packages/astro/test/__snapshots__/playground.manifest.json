    {
      "name": "events",
      "label": "Events",
      "editable": true,
      "source": {
        "loader": "glob",
        "base": "src/content/events",
        "pattern": "**/[^_]*.md",
        "generateId": "default",
        "formats": [
          "md"
        ]
      },
      "entryKind": "content",
      "fields": [
        {
          "path": [
            "title"
          ],
          "kind": "string",
          "required": true,
          "label": "Title",
