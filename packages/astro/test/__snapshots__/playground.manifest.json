                },
                {
                  "path": [
                    "hours",
                    "[]",
                    "closes"
                  ],
                  "kind": "string",
                  "required": true,
                  "label": "Closes",
                  "constraints": {
                    "pattern": "^\\d\\d:\\d\\d$"
                  },
                  "inferredWidget": "text",
                  "widget": "text"
                }
              ],
              "extraKeys": "strip",
              "inferredWidget": "group",
              "widget": "group"
            }
          ],
          "inferredWidget": "repeater",
          "widget": "store-hours"
