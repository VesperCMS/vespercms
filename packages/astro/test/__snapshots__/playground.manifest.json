        },
        {
          "path": [
            "endsAt"
          ],
          "kind": "date",
          "required": false,
          "label": "Ends at",
          "widget": "datetime",
          "coerce": true,
          "inferredWidget": "date",
          "placement": "main"
        },
        {
          "path": [
            "location"
          ],
          "kind": "reference",
          "required": false,
          "label": "Location",
