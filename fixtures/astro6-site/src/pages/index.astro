---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro 6 fixture</title>
  </head>
  <body>
    <main>
      <h1>Astro 6 fixture</h1>
      <ul>
        {posts.map((post) => (
          <li>{post.data.title}</li>
        ))}
      </ul>
    </main>
  </body>
</html>
